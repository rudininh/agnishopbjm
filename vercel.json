{
  "version": 2,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node -e \"console.log('Callback-only deployment; frontend build skipped')\"",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
